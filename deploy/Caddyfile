# Caddy gets and renews free SSL/TLS certificates automatically.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

# Send www.yourdomain to yourdomain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	# Small request limit everywhere, except the stamp upload (images up to 1 MB).
	@stamp path /api/admin/receipts/stamp/image
	request_body @stamp {
		max_size 2MB
	}
	@other not path /api/admin/receipts/stamp/image
	request_body @other {
		max_size 64KB
	}

	header {
		-Server
		-Via
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format console
	}
}
