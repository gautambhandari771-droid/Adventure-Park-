# ---------------------------------------------------------------------------
# Adventure Park website settings
# Copy this file to ".env" and fill in the values. NEVER commit .env to git.
# ---------------------------------------------------------------------------

# Your domain name WITHOUT https:// (used by Caddy to get the SSL certificate)
DOMAIN=adventurepark.in
# Email for SSL certificate expiry notices
ACME_EMAIL=adventurepark661@gmail.com

# Full public address of the website, WITH https://
PUBLIC_URL=https://adventurepark.in

# Long random secret. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=change-me-to-a-long-random-string

# Admin panel login (https://yourdomain/admin)
ADMIN_USERNAME=admin
# Create with:  npm run hash-password   (paste the full line it prints)
ADMIN_PASSWORD_HASH=

# Email alerts for new bookings (optional but recommended).
# For Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=adventurepark661@gmail.com
SMTP_PASS=
MAIL_FROM=adventurepark661@gmail.com
NOTIFY_EMAIL=adventurepark661@gmail.com

# Phone number printed on booking receipts. Leave it commented out to use the
# website number (+91 87555 42743).
# RECEIPT_PHONE=+91 87555 42743

# Optional tuning (defaults shown)
# RATE_LIMIT_GLOBAL=600       # requests per IP per 15 minutes
# RATE_LIMIT_BOOKINGS=8       # booking requests per IP per hour
# RATE_LIMIT_LOGIN=5          # failed admin logins per IP per 15 minutes
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=12
